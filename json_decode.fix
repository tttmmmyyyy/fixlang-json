// Reads what you want out of a JSON document and leaves the rest of it unread.
//
// A `Decoder a` reads an `a` from where the cursor stands and leaves the cursor behind what it
// read. Build one out of the primitives below, chain them with `*` and `;;`, and run it over a
// document with `decode`.
//
// ```
// // The number the member `x` of the object at the cursor holds.
// _x : Decoder F64;
// _x = (
//     enter_object;;
//     let span = *read_member;
//     let is_x = *is_named(span, "x");
//     if !is_x { Decoder::fail_expecting("the member x") };
//     read_number
// );
//
// let value = *_x.decode("{\"x\": 1.5}");   // ok(1.5)
// ```
//
// A string comes back as a `Span`, where its bytes stand in the document, and those bytes are the
// ones the document holds: an escape such as `\n` or `\u0041` stands there as the escape.
// `is_named` and `read_text` resolve the escapes; `is_named_as_written` reads the bytes as they
// stand.
//
// A reading that fails answers with a message naming what the grammar expected and where it stood.
module Json.Decode;

import Json::{Number::parse, Text::unescape};
import Std::{
    loop, loop_m, Array, Bool, ErrMsg, F64, Functor, I64, Monad, Result, String, U8, Array::{@, @size}, 
    LoopState::{break, break_m, continue, continue_m}, Monad::pure, Result::{err, ok}, 
    Array::pop_back, String::get_bytes, 
    ToString::to_string
};

// A document and how far into it a reading has come.
type Cursor = struct { _bytes : Array U8, _size : I64, _at : I64 };

// A cursor standing at the first byte of a document.
//
// # Parameters
// * `text` - The document to read.
make_cursor : String -> Cursor;
make_cursor = |text| (
    // `get_bytes` answers with the string's own array, whose last byte is the null terminator
    // the string keeps behind its text; the document ends one byte short of it.
    let bytes = text.get_bytes;
    Cursor { _bytes : bytes, _size : bytes.@size - 1, _at : 0 }
);

// Where the text of a string stands in a document, and whether an escape stands among its bytes.
type Span = struct { _from : I64, _to : I64, _escaped : Bool };

// The span of the bytes from `from` up to `to`, which `escaped` says whether an escape stands
// among.
//
// # Parameters
// * `from` - The position of the first byte of the text.
// * `to` - The position one past its last byte.
// * `escaped` - Whether a backslash stands between the two.
make_span : I64 -> I64 -> Bool -> Span;
make_span = |from, to, escaped| Span { _from : from, _to : to, _escaped : escaped };

namespace Span {
    // The position of the first byte of the text.
    from : Span -> I64;
    from = |span| span.@_from;

    // The position one past the last byte of the text.
    to : Span -> I64;
    to = |span| span.@_to;

    // Whether a backslash stands among the bytes, so that the text needs unescaping to be read.
    escaped : Span -> Bool;
    escaped = |span| span.@_escaped;
}

// A reading that takes a value out of a document and leaves the position after it.
type Decoder a = struct { _run : Cursor -> Result ErrMsg (a, Cursor) };

namespace Decoder {
    // Runs a reading over a whole document, and answers with what it read.
    //
    // # Parameters
    // * `text` - The document to read.
    // * `decoder` - The reading to run.
    decode : String -> Decoder a -> Result ErrMsg a;
    decode = |text, decoder| (
        let (value, _) = *decoder.run(make_cursor(text));
        ok $ value
    );

    // Runs a reading over a cursor, and answers with what it read and the cursor behind it.
    //
    // # Parameters
    // * `cursor` - Where the reading begins.
    // * `decoder` - The reading to run.
    run : Cursor -> Decoder a -> Result ErrMsg (a, Cursor);
    run = |cursor, decoder| (decoder.@_run)(cursor);

    // A reading that fails, saying what the grammar expected and where.
    //
    // # Parameters
    // * `what` - What the grammar expected there.
    fail_expecting : String -> Decoder a;
    fail_expecting = |what| Decoder { _run : |c| err $ "expected " + what + " at " + c.@_at.to_string };

    // Reads a member's name and the colon behind it, and answers with where the name stands.
    read_member : Decoder Span;
    read_member = (
        let quoted = *took('"');
        if !quoted { Decoder::fail_expecting("a member name") };
        let span = *read_text_span;
        skip_space;;
        take(':', "`:`");;
        skip_space;;
        pure $ span
    );

    // Reads the byte that closes a member list or separates it from the next member, and answers
    // with whether another member follows.
    //
    // # Parameters
    // * `closing` - The byte that closes this list.
    read_separator : U8 -> Decoder Bool;
    read_separator = |closing| (
        skip_space;;
        let separated = *took(',');
        if separated { pure $ true };
        let closed = *took(closing);
        if closed { pure $ false };
        Decoder::fail_expecting("`,` or a closing byte")
    );

    // Whether the byte at the cursor is `byte`, which is false where the document has ended.
    //
    // # Parameters
    // * `byte` - The byte to look for.
    is_at : U8 -> Decoder Bool;
    is_at = |byte| Decoder { _run : |c|
        ok $ (c.@_at < c.@_size && c.@_bytes.@(c.@_at) == byte, c)
    };

    // Moves the cursor one byte on.
    advance : Decoder ();
    advance = Decoder { _run : |c| ok $ ((), c.set__at(c.@_at + 1)) };

    // Takes the byte `byte`, failing where the document holds something else.
    //
    // # Parameters
    // * `byte` - The byte the grammar asks for there.
    // * `what` - What to call it in the report.
    take : U8 -> String -> Decoder ();
    take = |byte, what| (
        let taken = *took(byte);
        if !taken { Decoder::fail_expecting(what) };
        pure()
    );

    // Takes the byte `byte` where the cursor stands on it, and answers whether it did. Where the
    // cursor stands on another byte, or the document has ended, it stays where it is.
    //
    // # Parameters
    // * `byte` - The byte to take.
    took : U8 -> Decoder Bool;
    took = |byte| Decoder { _run : |c|
        if c.@_at >= c.@_size || c.@_bytes.@(c.@_at) != byte { ok $ (false, c) };
        ok $ (true, c.set__at(c.@_at + 1))
    };

    // Takes the brace an object opens with, leaving the cursor on its first member.
    enter_object : Decoder ();
    enter_object = take('{', "an object");

    // Takes the bracket an array opens with, leaving the cursor on its first element.
    enter_array : Decoder ();
    enter_array = take('[', "an array");

    // Moves the cursor past the white space it stands on.
    skip_space : Decoder ();
    skip_space = Decoder { _run : |c|
        let size = c.@_size;
        let bytes = c.@_bytes;
        let at = loop((c.@_at), |at|
            if at >= size { break $ at };
            let byte = bytes.@(at);
            if byte == ' ' || byte == '\t' || byte == '\n' || byte == '\r' { continue $ at + 1 };
            break $ at
        );
        ok $ ((), c.set__at(at))
    };

    // Reads the rest of a string whose opening quote the cursor has passed, and answers with where
    // its text stands.
    //
    // The walk to the closing quote sees every escape on its way, so the span it answers with says
    // whether one stands inside it.
    read_text_span : Decoder Span;
    read_text_span = Decoder { _run : |c|
        let size = c.@_size;
        let bytes = c.@_bytes;
        let from = c.@_at;
        loop((from, false), |(i, escaped)|
            if i >= size { break $ err $ "expected a closing quote at " + i.to_string };
            let byte = bytes.@(i);
            if byte == '"' {
                break $ ok $ (make_span(from, i, escaped), c.set__at(i + 1))
            };
            if byte == '\\' { continue $ (i + 2, true) };
            continue $ (i + 1, escaped)
        )
    };

    // The text the span stands for, with every escape resolved.
    //
    // # Parameters
    // * `span` - Where the text stands.
    read_text : Span -> Decoder String;
    read_text = |span| Decoder { _run : |c|
        let value = *Text::unescape(c.@_bytes, span.from, span.to);
        ok $ (value, c)
    };

    // Whether the text of `span` is `name`.
    //
    // A span that carries an escape has it resolved first, so a name written `"\\u0078"` answers to
    // `"x"`.
    //
    // # Parameters
    // * `span` - Where the name read from the document stands.
    // * `name` - The name to compare it against.
    is_named : Span -> String -> Decoder Bool;
    is_named = |span, name| (
        if span.escaped { Decoder { _run : |c| _named_escaped(span, name, c) } };
        is_named_as_written(span, name)
    );

    // Whether the bytes `span` stands on are `name`, taken as the document writes them.
    //
    // An escape among them stands as the escape, so a name written `"\\u0078"` does not answer to
    // `"x"`. Use this where the document is known to write its names plainly.
    //
    // # Parameters
    // * `span` - Where the name read from the document stands.
    // * `name` - The name to compare it against.
    is_named_as_written : Span -> String -> Decoder Bool;
    is_named_as_written = |span, name| Decoder { _run : |c|
        let bytes = c.@_bytes;
        // `get_bytes` answers with the string's own array, whose last byte is the null terminator.
        let name = name.get_bytes;
        let size = name.@size - 1;
        if span.to - span.from != size { ok $ (false, c) };
        let same = loop((0), |i|
            if i == size { break $ true };
            if bytes.@(span.from + i) != name.@(i) { break $ false };
            continue $ i + 1
        );
        ok $ (same, c)
    };

    // Whether the text of a span that carries an escape is `name`, which the escape is resolved
    // for first.
    //
    // # Parameters
    // * `span` - Where the name read from the document stands.
    // * `name` - The name to compare it against.
    // * `cursor` - Where the reading stands.
    _named_escaped : Span -> String -> Cursor -> Result ErrMsg (Bool, Cursor);
    _named_escaped = |span, name, cursor| (
        let value = *Text::unescape(cursor.@_bytes, span.from, span.to);
        ok $ (value == name, cursor)
    );

    // Reads a number, which runs to the first byte that no number can carry.
    read_number : Decoder F64;
    read_number = Decoder { _run : |c|
        let size = c.@_size;
        let bytes = c.@_bytes;
        let at = c.@_at;
        let end = loop((at), |i|
            if i >= size { break $ i };
            let byte = bytes.@(i);
            let carries = ('0' <= byte && byte <= '9') || byte == '-' || byte == '+' || byte == '.'
                || byte == 'e' || byte == 'E';
            if carries { continue $ i + 1 };
            break $ i
        );
        if end == at { err $ "expected a number at " + at.to_string };
        let value = *Number::parse(bytes, at, end);
        ok $ (value, c.set__at(end))
    };

    // Moves the cursor past the value it stands on, building nothing for it.
    skip_value : Decoder ();
    skip_value = (
        let quoted = *took('"');
        if quoted { read_text_span;; pure() };
        let object = *is_at('{');
        let array = *is_at('[');
        if object || array { _skip_nested };
        _skip_plain
    );

    // Moves the cursor past a number, `true`, `false` or `null`.
    _skip_plain : Decoder ();
    _skip_plain = Decoder { _run : |c|
        let size = c.@_size;
        let bytes = c.@_bytes;
        let at = c.@_at;
        let end = loop((at), |i|
            if i >= size { break $ i };
            let byte = bytes.@(i);
            if byte == ',' || byte == '}' || byte == ']' || byte == ' ' || byte == '\t'
                || byte == '\n' || byte == '\r' { break $ i };
            continue $ i + 1
        );
        if end == at { err $ "expected a value at " + at.to_string };
        ok $ ((), c.set__at(end))
    };

    // Moves the cursor past the object or array it stands on, counting the braces and brackets that
    // open and close inside it.
    _skip_nested : Decoder ();
    _skip_nested = loop_m(0, |depth|
        let quoted = *took('"');
        if quoted { read_text_span;; continue_m $ depth };
        let object = *is_at('{');
        let array = *is_at('[');
        if object || array { advance;; continue_m $ depth + 1 };
        let closed_object = *is_at('}');
        let closed_array = *is_at(']');
        if closed_object || closed_array {
            advance;;
            if depth == 1 { break_m $ () } else { continue_m $ depth - 1 }
        };
        let ended = *is_at_end;
        if ended { Decoder::fail_expecting("a closing brace or bracket") };
        advance;;
        continue_m $ depth
    );

    // Whether the cursor has reached the end of the document.
    is_at_end : Decoder Bool;
    is_at_end = Decoder { _run : |c| ok $ (c.@_at >= c.@_size, c) };
}

impl Decoder : Functor {
    map = |f, decoder| Decoder { _run : |c| (
        let (value, c) = *decoder.run(c);
        ok $ (f(value), c)
    ) };
}

impl Decoder : Monad {
    pure = |value| Decoder { _run : |c| ok $ (value, c) };
    bind = |f, decoder| Decoder { _run : |c| (
        let (value, c) = *decoder.run(c);
        f(value).run(c)
    ) };
}
